# Base de datos y configuración de cada instalación
data/*.sqlite
data/*.sqlite-*
data/db.php
data/mail.php
data/import/
# Todo lo que el programa genera dentro de data/ (cachés boxes/gaps/sigs.json, trabajos, copias, ajustes):
# solo se versiona data/.htaccess
data/*
!data/.htaccess

# Fotos subidas (se conservan .htaccess e index.html)
uploads/*
!uploads/.htaccess
!uploads/index.html

# Fotos de clientes (demasiado grandes y no son código)
FOTOS_ARTICULOS_*/
FOTOS_ARTICULOS_*.zip

# Datos reales de empresas para pruebas (nunca al repositorio)
pruebas/

# Registros locales y archivos del sistema
*.log
Thumbs.db
desktop.ini
.DS_Store
data/erp_*
